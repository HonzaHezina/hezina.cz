---
const steps = [
  {
    n: '1',
    time: '~1 týden',
    title: 'Diagnostika',
    body: 'Zmapuju, kde vás to reálně brzdí a co automatizovat vs. co ne. Výstup je dokument s konkrétním doporučením — i kdybychom dál nepokračovali.',
  },
  {
    n: '2',
    time: '2–4 týdny',
    title: 'Implementace, pokud dává smysl',
    body: 'Napojíme AI na vaše emaily a dokumenty. Bezpečně, u vás ve firmě. Cena diagnostiky se odečte od implementace.',
  },
  {
    n: '3',
    time: '~2 měsíce',
    title: 'Provoz a plný efekt',
    body: 'AI se učí, jak vaše firma funguje. Každý měsíc přidáváme další schopnosti — podle toho, co se osvědčilo.',
  },
];
---

<section class="section section--soft" id="proces">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>Jak to probíhá</span>
      <h2>Tři kroky.<br />Žádné překvapení.</h2>
      <p>Spolupráce není projekt na rok dopředu. Začneme malým krokem, který se vyplatí, a stavíme dál na výsledcích.</p>
    </div>

    <div class="process">
      {
        steps.map((s) => (
          <div class="step">
            <div class="step__num">{s.n}</div>
            <div class="step__body">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
            <div class="step__time">{s.time}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
