---
// Tři vzorce, které se v diagnostikách opakují nejčastěji — obecné, ne vázané
// na konkrétního klienta. Případná reálná anonymizovaná ukázka (obor, velikost
// firmy, co se skutečně stalo) čeká na dodání od Honzy — TODO níže, nefabrikovat.
const PATTERNS = [
  {
    label: '01 · Nástroj místo návyku',
    assumed: 'Firma chce nový nástroj — ten starý prý nefunguje.',
    actual: 'Nikdo starý systém pořádně nenaučil používat a data v něm nesedí.',
    whyNot: 'Nový nástroj problém nevyřeší, jen ho zdvojí.',
  },
  {
    label: '02 · Obcházené workflow',
    assumed: 'Firma chce tohle workflow zautomatizovat.',
    actual: 'Lidé ho obcházejí, protože v reálném provozu nedává smysl.',
    whyNot: 'Automatizace obcházení jen zabetonuje.',
  },
  {
    label: '03 · Nedůvěryhodná data',
    assumed: 'Firma chce nasadit AI nad svými daty.',
    actual: 'Datům nevěří ani lidé, kteří s nimi denně pracují.',
    whyNot: 'AI z nedůvěryhodných dat vyrobí jen rychlejší nesmysly.',
  },
];
// TODO: až Honza dodá reálný anonymizovaný případ (obor + velikost firmy, co se
// skutečně stalo, proč obvyklé řešení nezabralo), přidat jako čtvrtou kartu nebo
// samostatný blok pod PATTERNS. Nevymýšlet přiklad předem.
---

<section class="section section--soft" id="kde-se-lame">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>Kde se to obvykle láme</span>
      <h2>Než začnu stavět,<br />hledám skutečný problém.</h2>
      <p>
        Vím, jak vypadá systém, který nikdo nepoužívá správně, workflow, které všichni obcházejí, a data, kterým
        nikdo nevěří. Tohle jsou tři vzorce, které se opakují nejčastěji.
      </p>
    </div>

    <div class="breaks">
      {
        PATTERNS.map((p) => (
          <div class="breaks__card">
            <div class="breaks__industry">{p.label}</div>

            <div class="breaks__field">
              <span class="breaks__label">Co si firma myslí, že je problém</span>
              <p>{p.assumed}</p>
            </div>
            <div class="breaks__field">
              <span class="breaks__label">Co je problém doopravdy</span>
              <p>{p.actual}</p>
            </div>
            <div class="breaks__field breaks__field--why">
              <span class="breaks__label">Proč to obvyklé řešení nespraví</span>
              <p>{p.whyNot}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="breaks__close">
      Někdy je řešení AI. Někdy změna procesu. Někdy stačí přestat dělat blbost, kterou děláte pět let ze zvyku.
    </p>
  </div>
</section>
