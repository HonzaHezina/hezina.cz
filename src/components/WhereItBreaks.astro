// Pro každou položku potřebuju: obor + velikost firmy, co si firma myslela, že je
// problém, co byl problém ve skutečnosti, co se udělalo místo toho, a jednou větou proč
// to "obvyklé" řešení nefungovalo. 2–3 položky stačí.
const BREAKS = [
  {
    industry: 'TODO: obor firmy',
    size: 'TODO: velikost (počet lidí)',
    assumed: 'TODO: co si firma myslela, že je problém',
    actual: 'TODO: co byl problém ve skutečnosti',
    didInstead: 'TODO: co se udělalo místo toho',
    whyNot: 'TODO: proč obvyklé řešení nefungovalo (jedna věta)',
  },
  {
    industry: 'TODO: obor firmy',
    size: 'TODO: velikost (počet lidí)',
    assumed: 'TODO: co si firma myslela, že je problém',
    actual: 'TODO: co byl problém ve skutečnosti',
    didInstead: 'TODO: co se udělalo místo toho',
    whyNot: 'TODO: proč obvyklé řešení nefungovalo (jedna věta)',
  },
