---
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="eyebrow"><span class="dot"></span>AI agent pro malé a střední firmy</span>
      <h1>Váš vlastní <span class="accent">Jarvis</span><br />pro firmu.</h1>
      <p class="hero__lead">
        AI asistent napojený na vaše emaily, dokumenty a zakázky. Učí se, jak vaše firma funguje. Postupně přebírá
        rutinní práci. Žádná krabice — systém šitý na míru, který roste s vámi.
      </p>

      <div class="hero__ctas">
        <a href="#kontakt" class="btn btn--primary btn--lg">
          Domluvit hovor zdarma (20 min)
          <span class="arrow">→</span>
        </a>
        <a href="#diagnostika" class="btn btn--ghost btn--lg">Nejsem si jistý ↓</a>
      </div>

      <p class="hero__microcopy">Ozvu se do 24 hodin. Pokud to u vás nemá smysl, řeknu vám to rovnou.</p>

      <div class="hero__meta">
        <span><span class="check">✓</span> Vaše data zůstávají vaše</span>
        <span><span class="check">✓</span> Přesně víte, co AI udělala a proč</span>
        <span><span class="check">✓</span> Pilot za 2–4 týdny</span>
      </div>
    </div>

    <div class="hero__visual">
      <div class="jarvis-card">
        <div class="jarvis-head">
          <span class="jarvis-head__dot"><i></i> Živá ukázka · zkuste si</span>
          <span class="mono">demo</span>
        </div>

        <div class="jarvis-scroll" id="jarvis-scroll">
          <div class="msg msg--system">
            <div class="msg__bubble">Vyberte ukázkový dotaz, nebo si napište vlastní. Odpověď uvidíte za 1–2 vteřiny.</div>
          </div>
        </div>

        <div class="jarvis-samples" id="jarvis-samples">
          <button type="button" class="sample-pill" data-q="Připrav mi shrnutí zakázky Novák s.r.o. na zítřejší schůzku.">
            Připrav mi shrnutí zakázky Novák s.r.o. na …
          </button>
          <button type="button" class="sample-pill" data-q="Kolik faktur zbývá zaplatit do konce týdne?">
            Kolik faktur zbývá zaplatit do konce týdn…
          </button>
          <button type="button" class="sample-pill" data-q="Najdi mi všechny smlouvy s klientem ABC za poslední rok.">
            Najdi mi všechny smlouvy s klientem ABC z…
          </button>
          <button type="button" class="sample-pill" data-q="Odpověz panu Svobodovi že termín posuneme o týden.">
            Odpověz panu Svobodovi že termín posunem…
          </button>
        </div>

        <form class="jarvis-input" id="jarvis-form">
          <input type="text" id="jarvis-input-field" placeholder="Napište vlastní dotaz…" autocomplete="off" />
          <button type="submit" class="jarvis-send" id="jarvis-send" aria-label="Odeslat" disabled>→</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  type Fallback = { summary: string; bullets: string[]; next: string };

  const FALLBACKS: Record<string, Fallback> = {
    'Připrav mi shrnutí zakázky Novák s.r.o. na zítřejší schůzku.': {
      summary: 'Mám 3 dokumenty, 11 emailů a aktuální fakturu k Novák s.r.o.',
      bullets: [
        'Termín dodání: 12. 5. (zbývá 8 dní)',
        'Čeká schválení cenové doložky z 28. 4.',
        'Klient čeká odpověď na nabídku z pondělí',
        'Poslední platba: 145 200 Kč přijata 22. 4.',
      ],
      next: 'Mám připravit návrh emailu s upravenou cenovou doložkou?',
    },
    'Kolik faktur zbývá zaplatit do konce týdne?': {
      summary: 'Do pátku 9. 5. zbývá uhradit 4 faktury — celkem 187 340 Kč.',
      bullets: [
        'Dodavatel A: 84 200 Kč · splatnost zítra',
        'Dodavatel B: 32 100 Kč · splatnost čtvrtek',
        'Dodavatel C: 48 600 Kč · splatnost pátek',
        'Dodavatel D: 22 440 Kč · splatnost pátek',
      ],
      next: 'Připravit příkaz k úhradě přes vaši banku?',
    },
    'Najdi mi všechny smlouvy s klientem ABC za poslední rok.': {
      summary: 'Našel jsem 7 smluv s ABC s.r.o. od 5/2025 do 4/2026.',
      bullets: [
        'Rámcová smlouva (5/2025) — stále platná',
        '4 dílčí objednávky · celkem 1.24 mil. Kč',
        '2 dodatky (poslední 3/2026 — prodloužení)',
        'Žádná otevřená pohledávka',
      ],
      next: 'Chcete shrnutí klíčových bodů z rámcové smlouvy?',
    },
    'Odpověz panu Svobodovi že termín posuneme o týden.': {
      summary: 'Připravil jsem návrh odpovědi panu Svobodovi.',
      bullets: [
        '„Dobrý den, pane Svobodo,"',
        '„děkuji za trpělivost. Termín dodání musíme posunout o jeden týden — z 14. 5. na 21. 5."',
        '„Důvod: zpoždění komponentu od dodavatele B. Garantujeme původní cenu i kvalitu."',
        '„S pozdravem, [Vy]"',
      ],
      next: 'Schválit a odeslat, nebo upravit?',
    },
  };

  const GENERIC_FALLBACK: Fallback = {
    summary: 'Tohle je jen ukázka. Naživo by AI měla přístup k vašim emailům a dokumentům.',
    bullets: [
      'Konkrétní odpověď podle vašich dat',
      'Návrh dalšího kroku k vašemu schválení',
      'Žádné domnělé odpovědi — vždy ze zdroje',
    ],
    next: 'Chcete vidět, jak by to fungovalo na vašem případu? Domluvte si 20min hovor.',
  };

  const scrollEl = document.getElementById('jarvis-scroll') as HTMLElement;
  const samplesEl = document.getElementById('jarvis-samples') as HTMLElement;
  const formEl = document.getElementById('jarvis-form') as HTMLFormElement;
  const inputEl = document.getElementById('jarvis-input-field') as HTMLInputElement;
  const sendBtn = document.getElementById('jarvis-send') as HTMLButtonElement;

  let busy = false;

  function scrollToBottom() {
    scrollEl.scrollTop = scrollEl.scrollHeight;
  }

  function addUserMessage(text: string) {
    const el = document.createElement('div');
    el.className = 'msg msg--user';
    el.innerHTML = `<div class="msg__avatar">Vy</div><div class="msg__bubble"><span class="label">Vy</span></div>`;
    (el.querySelector('.msg__bubble') as HTMLElement).append(text);
    scrollEl.appendChild(el);
    scrollToBottom();
  }

  function addTyping() {
    const el = document.createElement('div');
    el.className = 'msg msg--ai';
    el.id = 'jarvis-typing';
    el.innerHTML = `<div class="msg__avatar">AI</div><div class="msg__bubble"><span class="typing"><i></i><i></i><i></i></span></div>`;
    scrollEl.appendChild(el);
    scrollToBottom();
  }

  function removeTyping() {
    document.getElementById('jarvis-typing')?.remove();
  }

  function addAiMessage(answer: Fallback) {
    const el = document.createElement('div');
    el.className = 'msg msg--ai';
    const bullets = answer.bullets.map((b) => `<li>${b}</li>`).join('');
    el.innerHTML = `
      <div class="msg__avatar">AI</div>
      <div class="msg__bubble">
        <span class="label">Asistent · 2 s</span>
        <strong>${answer.summary}</strong>
        <ul class="ai-bullets">${bullets}</ul>
        <div class="ai-next">
          ${answer.next}
          <div class="ai-actions">
            <button type="button" class="pill">Upravit</button>
            <button type="button" class="pill pill--primary">Schválit</button>
          </div>
        </div>
      </div>`;
    scrollEl.appendChild(el);
    scrollToBottom();
  }

  function setBusy(v: boolean) {
    busy = v;
    inputEl.disabled = v;
    sendBtn.disabled = v || !inputEl.value.trim();
    samplesEl.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = v));
  }

  async function ask(q: string) {
    if (!q.trim() || busy) return;
    addUserMessage(q);
    inputEl.value = '';
    setBusy(true);
    addTyping();

    const answer = FALLBACKS[q];
    await new Promise((r) => setTimeout(r, 700));
    removeTyping();
    addAiMessage(answer ?? GENERIC_FALLBACK);
    setBusy(false);
  }

  samplesEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-q]') as HTMLButtonElement | null;
    if (btn) ask(btn.dataset.q ?? '');
  });

  formEl.addEventListener('submit', (e) => {
    e.preventDefault();
    ask(inputEl.value);
  });

  inputEl.addEventListener('input', () => {
    sendBtn.disabled = busy || !inputEl.value.trim();
  });
</script>
