---
---

<section class="section" id="kontakt">
  <div class="container">
    <div class="contact">
      <div>
        <span class="eyebrow" style="color: oklch(0.78 0.12 230)">
          <span class="dot" style="background: oklch(0.78 0.12 230)"></span>
          Kontakt
        </span>
        <h2 style="margin-top: 14px">Zavolejte mi nebo napište.</h2>
        <p>
          Napište pár vět o tom, co řešíte, a domluvíme diagnostiku. Pokud AI nedává smysl, řeknu vám to rovnou — a
          oba ušetříme čas. Žádný prodejní tlak.
        </p>

        <div class="contact-card" style="margin-top: 32px">
          <a class="contact-card__row" href="mailto:info@hezina.cz">
            <span class="label">Email</span>
            <span>info@hezina.cz</span>
            <span class="arrow">→</span>
          </a>
          <a class="contact-card__row" href="tel:+420722109060">
            <span class="label">Telefon</span>
            <span>+420 722 10 90 60</span>
            <span class="arrow">→</span>
          </a>
          <a class="contact-card__row" href="https://www.linkedin.com/in/jan-hezina/" target="_blank" rel="noopener">
            <span class="label">LinkedIn</span>
            <span>jan-hezina</span>
            <span class="arrow">↗</span>
          </a>
        </div>
      </div>

      <div style="position: relative; z-index: 1">
        <div class="cform" id="cform-success" style="display: none">
          <div class="ok">
            <strong style="display: block; margin-bottom: 6px">Děkuji, mám to.</strong>
            Ozvu se vám během dneška nebo nejpozději zítra dopoledne. Mezitím můžete v klidu zavřít okno.
          </div>
        </div>

        <form class="cform" id="cform" novalidate>
          <div>
            <label for="cf-name">Jméno</label>
            <input id="cf-name" name="name" type="text" placeholder="Jan Novák" autocomplete="name" />
            <div class="err" id="cf-name-err" style="display: none"></div>
          </div>
          <div>
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" placeholder="vy@firma.cz" autocomplete="email" />
            <div class="err" id="cf-email-err" style="display: none"></div>
          </div>
          <div>
            <label for="cf-msg">Co byste chtěli ve firmě zrychlit?</label>
            <textarea
              id="cf-msg"
              name="msg"
              rows="3"
              placeholder={'Pár vět stačí. Třeba: „Trávíme moc času hledáním v emailech a smlouvách."'}></textarea>
            <div class="err" id="cf-msg-err" style="display: none"></div>
          </div>
          <!-- honeypot — hidden from real users -->
          <input
            type="text"
            name="website"
            id="cf-website"
            tabindex="-1"
            autocomplete="off"
            style="position: absolute; left: -9999px; opacity: 0; pointer-events: none"
            aria-hidden="true"
          />
          <button type="submit" class="btn btn--blue btn--lg" style="width: 100%; margin-top: 8px" id="cform-submit">
            <span id="cform-submit-label">Objednat diagnostiku<span class="arrow">→</span></span>
          </button>
          <p
            id="cform-error"
            style="font-size: 13px; color: oklch(0.58 0.18 25); margin-top: 6px; text-align: center; display: none"
          >
          </p>
          <p style="font-size: 12px; color: oklch(0.66 0.014 250); margin-top: 4px; text-align: center">
            Odpovídám obvykle do 24 hodin.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const CONTACT_ENDPOINT = 'https://n8n.janagi.org/webhook/contact';

  const form = document.getElementById('cform') as HTMLFormElement;
  const successEl = document.getElementById('cform-success') as HTMLElement;
  const submitBtn = document.getElementById('cform-submit') as HTMLButtonElement;
  const submitLabel = document.getElementById('cform-submit-label') as HTMLElement;
  const errorEl = document.getElementById('cform-error') as HTMLElement;

  const nameInput = document.getElementById('cf-name') as HTMLInputElement;
  const emailInput = document.getElementById('cf-email') as HTMLInputElement;
  const msgInput = document.getElementById('cf-msg') as HTMLTextAreaElement;
  const websiteInput = document.getElementById('cf-website') as HTMLInputElement;

  const nameErr = document.getElementById('cf-name-err') as HTMLElement;
  const emailErr = document.getElementById('cf-email-err') as HTMLElement;
  const msgErr = document.getElementById('cf-msg-err') as HTMLElement;

  function clearErr(el: HTMLElement) {
    el.style.display = 'none';
    el.textContent = '';
  }
  function setErr(el: HTMLElement, msg: string) {
    el.style.display = '';
    el.textContent = msg;
  }

  [nameInput, emailInput, msgInput].forEach((input, i) => {
    input.addEventListener('input', () => clearErr([nameErr, emailErr, msgErr][i]));
  });

  function validate() {
    let ok = true;
    clearErr(nameErr);
    clearErr(emailErr);
    clearErr(msgErr);

    if (!nameInput.value.trim()) {
      setErr(nameErr, 'Jak vám mám říkat?');
      ok = false;
    }
    if (!emailInput.value.trim()) {
      setErr(emailErr, 'Bez emailu se vám neozvu.');
      ok = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
      setErr(emailErr, 'Tohle nevypadá jako email.');
      ok = false;
    }
    if (!msgInput.value.trim()) {
      setErr(msgErr, 'Napište pár slov o tom, co řešíte.');
      ok = false;
    }
    return ok;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!validate()) return;
    if (websiteInput.value) return; // honeypot

    submitBtn.disabled = true;
    submitLabel.textContent = 'Odesílám…';
    errorEl.style.display = 'none';

    try {
      const fd = new FormData();
      fd.append('site_id', 'hezina');
      fd.append('name', nameInput.value);
      fd.append('email', emailInput.value);
      fd.append('message', msgInput.value);
      fd.append('website', websiteInput.value);
      const res = await fetch(CONTACT_ENDPOINT, { method: 'POST', body: fd });
      if (!res.ok) throw new Error('bad response');
      form.style.display = 'none';
      successEl.style.display = '';
    } catch {
      errorEl.textContent = 'Odeslání se nepovedlo. Zkuste to prosím znovu nebo napište přímo na info@hezina.cz';
      errorEl.style.display = '';
    } finally {
      submitBtn.disabled = false;
      submitLabel.innerHTML = 'Objednat diagnostiku<span class="arrow">→</span>';
    }
  });
</script>
