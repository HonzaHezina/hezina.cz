---
const SERVICES = [
  {
    id: 'diagnostika',
    tag: 'Hlavní služba',
    title: 'Provozní diagnostika',
    lead: 'Než cokoli stavím, zjistím, kde vás to reálně brzdí. Ne kde si myslíte, že se to láme — kde se to láme doopravdy. Výstup je dokument, ne prodejní schůzka.',
    bullets: [
      'Co automatizovat a co ne',
      'Co se u vás rozbije dřív, než se dostanete k AI',
      'Návrh prvního kroku — i bez mé další účasti',
      'Cena je odečitatelná od implementace, pokud budeme pokračovat',
    ],
    price: '40 000 Kč',
    priceNote: 'jednorázově · ~1 týden',
    cta: 'Objednat diagnostiku →',
    href: '#kontakt',
  },
  {
    id: 'implementace',
    tag: 'Navazující krok',
    title: 'Implementace AI asistenta',
    lead: 'Po diagnostice, pokud dává smysl, postavím vám AI asistenta na míru. Napojený na vaše emaily, dokumenty a zakázky. První funkční verze za 2–4 týdny od podpisu.',
    bullets: [
      'Nastavení a napojení na vaše systémy',
      'Zaškolení vás i vašeho týmu',
      'Průběžný rozvoj a podpora',
      'Plný efekt (AI zná firmu) přichází po ~2 měsících provozu',
    ],
    price: 'od 50 000 Kč',
    priceNote: '+ měsíční paušál',
    cta: 'Vidět cenu →',
    href: '#cena',
  },
  {
    id: 'skoleni',
    tag: 'Pro celý tým',
    title: 'Školení AI pro firmy',
    lead: 'Praktický kurz, jak AI reálně používat ve firmě. Žádné teoretické přednášky — píšeme prompty na vašich případech, řešíme vaše problémy. Školím dospělé od roku 2001 — začínal jsem v bance, kde se lidé báli i Excelu.',
    bullets: [
      'Půldenní nebo celodenní workshop',
      'Až 12 lidí v jedné skupině',
      'Vlastní firemní příklady, ne hraní si',
      'U vás v kanceláři nebo online',
    ],
    price: '18 000 Kč',
    priceNote: 'půlden / skupina',
    cta: 'Domluvit termín →',
    href: '#kontakt',
  },
];
---

<section class="section" id="sluzby">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow"><span class="dot"></span>Co nabízím</span>
      <h2>Nejdřív diagnostika.<br />Pak, pokud dává smysl, systém.</h2>
      <p>
        Diagnostika je vstupní bod — zjistí, jestli implementace vůbec dává smysl. Školení je samostatná volba,
        pokud chcete tým naučit AI používat bez nasazování systému.
      </p>
    </div>

    <div class="svc">
      <div class="svc__tabs" role="tablist" id="svc-tabs">
        {
          SERVICES.map((s, i) => (
            <button
              role="tab"
              aria-selected={i === 0}
              class={'svc__tab' + (i === 0 ? ' is-active' : '')}
              data-id={s.id}
            >
              <span class="svc__tab-tag mono">{s.tag}</span>
              <span class="svc__tab-title">{s.title}</span>
              <span class="svc__tab-price">{s.price}</span>
            </button>
          ))
        }
      </div>

      {
        SERVICES.map((s, i) => (
          <div class="svc__panel" data-panel={s.id} style={i === 0 ? undefined : { display: 'none' }}>
            <div class="svc__panel-grid">
              <div>
                <span class="svc__panel-tag mono">{s.tag}</span>
                <h3>{s.title}</h3>
                <p class="svc__lead">{s.lead}</p>
                <ul class="svc__list">
                  {s.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
              <div class="svc__price-card">
                <div class="svc__price-tag mono">Cena</div>
                <div class="svc__price-amount">{s.price}</div>
                <div class="svc__price-note">{s.priceNote}</div>
                <a href={s.href} class="btn btn--blue btn--lg svc__cta">
                  {s.cta}
                </a>
                <p class="svc__price-foot">
                  Nevíte, co si vybrat? <a href="#kontakt">Napište mi</a> — poradím.
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = document.getElementById('svc-tabs') as HTMLElement;
  const panels = document.querySelectorAll('.svc__panel') as NodeListOf<HTMLElement>;

  tabs.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-id]') as HTMLButtonElement | null;
    if (!btn) return;
    const id = btn.dataset.id;

    tabs.querySelectorAll('.svc__tab').forEach((t) => {
      t.classList.toggle('is-active', t === btn);
      t.setAttribute('aria-selected', String(t === btn));
    });
    panels.forEach((p) => {
      p.style.display = p.dataset.panel === id ? '' : 'none';
    });
  });
</script>
